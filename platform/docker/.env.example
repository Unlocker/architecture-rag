# Демо-значения стенда. Скопируйте в .env (он в .gitignore): cp .env.example .env
# Секреты (пароли, ключи S3, webhook) compose раздаёт сервисам как Docker secrets из этих переменных (E5.2).

# Порт, на котором reverse-proxy публикуется на хосте (TLS, https://localhost:<порт>). Он же входит в URI MCP resource (audience токена).
ARCHRAG_PUBLIC_PORT=8443

POSTGRES_DB=archrag
POSTGRES_USER=archrag
POSTGRES_PASSWORD=demo-postgres-password

# writer (пользователь neo4j): только ingestion и neo4j-init.
NEO4J_PASSWORD=demo-neo4j-password
# reader (пользователь archrag_reader): единственный креденшел Neo4j у mcp-server.
NEO4J_READER_PASSWORD=demo-neo4j-reader-password

S3_ACCESS_KEY=demo-access-key
S3_SECRET_KEY=demo-secret-key
S3_BUCKET=archrag-raw

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=demo-keycloak-admin-password
# Секрет клиента archrag-demo (client_credentials), импортируется в realm.
KEYCLOAK_CLIENT_SECRET=demo-client-secret

# Общий секрет подписи webhook между заглушками/источниками и адаптерами.
WEBHOOK_SECRET=demo-webhook-secret

# Токен заглушки EAM в формате реального API (eam-api-stub): заголовок Authorization: Token <значение>.
EAM_API_TOKEN=demo-eam-api-token

# Бакет S3 (SeaweedFS) для резервных копий scripts/backup.sh (E5.4); отдельно от бакета raw payload.
BACKUP_BUCKET=archrag-backups

# Метрики OTLP из mcp-server и ingestion; для профиля observability ставь true (docker compose --profile observability up).
ARCHRAG_OBSERVABILITY=false
# Grafana (профиль observability): порт на 127.0.0.1 и пароль admin (Docker secret).
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=demo-grafana-admin-password
